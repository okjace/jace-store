# From Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Public URL of the deployed site (used in launcher links / API responses)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "Sign in with Jace" (register the app at jaceo.vercel.app; redirect URI:
#   <NEXT_PUBLIC_SITE_URL>/api/auth/jace/callback)
JACE_CLIENT_ID=
JACE_CLIENT_SECRET=
# Supabase -> Project Settings -> API Keys -> service_role / secret key.
# SERVER ONLY — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 for project files (lib/fileStorage.ts). Files go to R2 until Jace Store's own R2 files
# reach R2_LIMIT_GB (4.5 GB by default), then to Supabase Storage. Leave these out to use only Supabase.
# The bucket needs public read access (R2_PUBLIC_URL) and CORS allowing PUT from this site.
# Sharing a Cloudflare account (or even a bucket) with Jace Social is fine: Jace Store's files live
# under R2_PREFIX and only those count. Keep Jace Social's R2_LIMIT_GB + this one under 10 GB to stay free.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev
# CLOUDFLARE_ACCOUNT_ID=          (or R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com)
# R2_LIMIT_GB=4.5
# R2_PREFIX=jace-store
