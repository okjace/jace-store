# From Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Public URL of the deployed site (used in launcher links / API responses)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "Sign in with Jace" (register the app at jaceo.vercel.app; redirect URI:
#   <NEXT_PUBLIC_SITE_URL>/api/auth/jace/callback)
JACE_CLIENT_ID=
JACE_CLIENT_SECRET=
# Supabase -> Project Settings -> API Keys -> service_role / secret key.
# SERVER ONLY — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
